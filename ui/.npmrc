# Supply-chain hygiene (docs/architecture.md, Frontend):
# no install scripts, exact versions, refuse unsupported Node.
ignore-scripts=true
save-exact=true
engine-strict=true
fund=false
# The two-week rule (CLAUDE.md), in npm's own terms. npm 10 (bundled with
# Node 22.16) ignores this key; it takes effect on npm versions that support
# it. Until then the rule is enforced by `npm install --before=<date>` and
# Dependabot's cooldown.
min-release-age=14
