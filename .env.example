# Copy to .env (git-ignored) and fill in. docker compose reads it
# automatically. Shell variables override it.
# Leave a setting commented out rather than blank: a blank value is passed
# through as empty and spall refuses it.

# A practice target: `docker compose --profile lab up -d` runs OWASP Juice
# Shop (deliberately vulnerable) on the compose network, unpublished. Browse
# it through the proxy as http://juice.lab:3000 and scope to it:
# SPALL_SCOPE=juice.lab

# Published ports (127.0.0.1 only).
# TAPHTTP_PORT=8080   # proxy: point your client here
# SPALL_PORT=3000     # web UI: http://127.0.0.1:3000

# Hosts replay and agents may send to (exact, *.wildcard, IP, CIDR).
# Empty means none.
# SPALL_SCOPE=app.example.test,*.api.example.test

# Agent host (off unless a provider is set).
# Anthropic:
# SPALL_MODEL_PROVIDER=anthropic
# SPALL_MODEL_KEY=sk-ant-...
# SPALL_MODEL=claude-opus-5-5   # default when unset
#
# A local OpenAI-compatible model (Ollama, llama.cpp); traffic stays here:
# SPALL_MODEL_PROVIDER=openai
# SPALL_MODEL=qwen3
# SPALL_MODEL_URL=http://host.docker.internal:11434/v1
#
# SPALL_MODEL_KEY puts the key in the container's environment, where
# `docker inspect` shows it. To keep it out of there, mount a 0600 key file
# read-only and point SPALL_MODEL_KEY_FILE at its path in the container.
# SPALL_MODEL_KEY_FILE=/run/secrets/model-key

# Out-of-band callbacks (#1): a self-hosted interactsh server. In a lab,
# run the bundled one with `docker compose --profile oob up -d` and set:
# SPALL_OAST_SERVER=http://interactsh
# SPALL_OAST_DOMAIN=oast.lab
# SPALL_OAST_HTTP=http://interactsh   # payload URLs lab targets can reach
# SPALL_OAST_TOKEN=<a long random string; the server and spall share it>
# For internet targets, point these at your VPS server and its delegated
# subdomain instead (see the README). Never a public oast.* server.

# Agent tool sandbox (#13): under compose, through the sandbox sensor
# (gVisor must be a Docker runtime on the host):
# SPALL_SANDBOX_URL=http://sandboxd:8070
# COMPOSE_PROFILES=sandbox,lab,oob
# Or, spall on the host starting sandboxes itself:
# docker build -t spall-sandbox:dev sandbox/
# SPALL_SANDBOX_IMAGE=spall-sandbox:dev
# Its network (slice 2): the internal network compose creates, where
# taphttp's credential-only listener (taphttp#27) is the only way out.
# SPALL_SANDBOX_NETWORK=spall-sandbox
# SPALL_SANDBOX_PROXY=taphttp:8090   (compose sets 172.31.81.10:8090: gVisor has no Docker DNS)
